            "description": {
                "brief": "One-month immersive practical training in natural farming, seed conservation, animal husbandry, and sustainable living practices.",
                "full": "This one-month intensive training program is completely practical-based and designed for participants who are willing to engage in physical farm work and learn by doing. The training follows a structured daily routine including planning, field execution, reflection, and documentation. Participants will work on real land, manage crops, learn animal husbandry, build seed banks, and understand traditional ecological farming systems. The program also includes farm visits, group discussions, documentation, volunteering activities, and community-based learning.",
                "objectives": [
                    "Provide hands-on training in natural and ecological farming",
                    "Teach land preparation and crop planning",
                    "Train participants in seed conservation and seed bank creation",
                    "Develop skills in animal husbandry and farm ecosystem management",
                    "Introduce traditional and ethnic medical practices",
                    "Build practical knowledge in nursery and bed preparation",
                    "Teach pest management and crop management",
                    "Provide exposure to farm-based value addition and marketing",
                    "Encourage documentation and reflective learning",
                    "Promote community-based collaborative farming practices"
                ],
                "curriculum": [
                    {
                        "module": "Land & Soil Preparation",
                        "topics": [
                            "Land preparation methods",
                            "Soil preparation techniques",
                            "Tool handling and safety",
                            "Permaculture Bed formation methods"
                        ]
                    },
                    {
                        "module": "Seeds & Nursery Management",
                        "topics": [
                            "Seed treatment techniques",
                            "Nursery bed preparation",
                            "Climber bed structures",
                            "Seed bank creation",
                            "Seed preservation methods"
                        ]
                    },
                    {
                        "module": "Crop Cultivation",
                        "topics": [
                            "Rain-fed millet cultivation",
                            "Crop planning",
                            "Seasonal crop selection",
                            "Mixed cropping methods",
                            "Crop management practices"
                        ]
                    },
                    {
                        "module": "Pest & Disease Management",
                        "topics": [
                            "Natural pest control methods",
                            "Traditional pest repellents",
