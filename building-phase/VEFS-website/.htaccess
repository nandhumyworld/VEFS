RewriteEngine On

# Force HTTPS (Hostinger production)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Clean URL for blog single posts
RewriteRule ^blog/([a-z0-9-]+)/?$ blog-post.php?id=$1 [L,QSA]

# Clean URL for project detail pages
RewriteRule ^projects/([a-z0-9-]+)/?$ project-detail.php?slug=$1 [L,QSA]

# Deny tmp/log artifacts
<FilesMatch "\.(tmp|log)$">
    Require all denied
</FilesMatch>

# Deny dot-files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
